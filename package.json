{
  "type": "module",
  "distDir": "dist",
  "devPort": 4556,
  "previewPort": 4558,
  "scripts": {
    "dev": "kosmo serve",
    "dev:sender": "tsx watch workers/sender.ts",
    "dev:smtp": "tsx watch workers/smtp.ts",
    "build": "kosmo build && node scripts/build-workers.mjs",
    "preview": "kosmo preview",
    "start": "node dist/run.js",
    "start:sender": "node dist-workers/sender.js",
    "start:smtp": "node dist-workers/smtp.js",
    "typecheck": "kosmo typecheck && tsc --noEmit -p tsconfig.shared.json",
    "folder": "kosmo folder",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@kosmojs/core": "^0.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.7",
    "light-my-request": "^6.6.0",
    "lucide-react": "^1.43.0",
    "mailparser": "^3.9.23",
    "nodemailer": "^10.0.1",
    "path-to-regexp": "^8.4.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-router": "^8.3.1",
    "smtp-server": "^3.19.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typebox": "^1.3.30"
  },
  "devDependencies": {
    "@kosmojs/cli": "^0.5.0",
    "@kosmojs/dev": "^0.5.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.2",
    "@types/deno": "^2.7.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.28.2",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "name": "mailhub",
  "version": "1.0.0",
  "description": "One self-hosted hub to store, review, and send the emails from all your projects.",
  "license": "MIT",
  "private": true
}
