# MailHub configuration.
#
# Every value below has a working default, so an empty environment still boots:
# the database lands in var/mailhub.db and system email is written to the log.
# What a real install must set is the session secret and the system-mail block.

# ── storage ─────────────────────────────────────────────────────────────────
# SQLite file. Use an absolute path in production; the directory is created.
MAILHUB_DB=var/mailhub.db

# ── the hub (web application) ───────────────────────────────────────────────
# Signs session cookies. Generate one and keep it: rotating it signs everyone
# out, which is also the emergency lever if you ever need one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILHUB_SESSION_SECRET=change-me

MAILHUB_SESSION_TTL_HOURS=336
# Set false only when the hub is served over plain HTTP on a private network.
MAILHUB_SECURE_COOKIES=true

# ── system email (§2.1.8) ───────────────────────────────────────────────────
# Confirmation codes, and anything else MailHub sends on its own behalf. This is
# NOT one of the providers admins manage - it is the installation's own path,
# and nothing sent through it is ever stored as an email.
#
# With no host configured, messages are written to the log instead. A fresh
# install works end to end that way: read the code off the console.
MAILHUB_SYSTEM_MAIL_FROM=MailHub <mailhub@example.com>
#MAILHUB_SYSTEM_MAIL_HOST=smtp.example.com
MAILHUB_SYSTEM_MAIL_PORT=587
MAILHUB_SYSTEM_MAIL_SECURE=false
#MAILHUB_SYSTEM_MAIL_USER=
#MAILHUB_SYSTEM_MAIL_PASS=

# ── the credential-change gate (§2.1.7) ─────────────────────────────────────
MAILHUB_CONFIRMATION_TTL_MINUTES=15
MAILHUB_CONFIRMATION_MAX_ATTEMPTS=5
# Codes allowed per account and per recipient inside the window - the gate must
# not be turnable into a mail cannon.
MAILHUB_CONFIRMATION_RATE_LIMIT=5
MAILHUB_CONFIRMATION_RATE_WINDOW_MINUTES=60

# ── the background sender (§4.1) ────────────────────────────────────────────
MAILHUB_SENDER_INTERVAL_MS=5000
MAILHUB_SENDER_BATCH_SIZE=20
# After this many failed attempts an email waits for a human. Pressing Send in
# the UI ignores the cap - that IS the intervention it waits for.
MAILHUB_SENDER_MAX_ATTEMPTS=3

# ── the SMTP listener (§3.6) ────────────────────────────────────────────────
# LAN/DMZ only, never the public internet. The collection id is the credential,
# presented via SMTP AUTH as the password (or the username).
MAILHUB_SMTP_HOST=127.0.0.1
MAILHUB_SMTP_PORT=2525
MAILHUB_SMTP_MAX_SIZE=26214400
MAILHUB_SMTP_BANNER=MailHub

# ── delivery-event webhooks (§3.4) ──────────────────────────────────────────
# Per-provider-type signing keys, as `type=key` pairs. A type with no key
# configured accepts unsigned events; verification is HMAC-SHA256 of the raw
# request body, hex, in the `x-mailhub-signature` header.
#MAILHUB_WEBHOOK_KEYS=sendgrid=secret1,ses=secret2
